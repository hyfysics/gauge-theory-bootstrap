     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"Re", 
        OverscriptBox["h", "~"]}], ")"}], "2"], "+", " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"Im", 
        OverscriptBox["h", "~"]}], ")"}], "2"]}], "\[LessEqual]", " ", "2"}], 
   TraditionalForm]],ExpressionUUID->"b44b301f-2972-41e5-a8aa-aa4add6912b8"],
