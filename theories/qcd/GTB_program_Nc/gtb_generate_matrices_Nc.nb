Cell[BoxData[{
 RowBox[{"Clear", "[", "b", "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"F", "[", "z_", "]"}], "=", " ", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      SubscriptBox["b", "n"], " ", 
      SuperscriptBox["z", "n"]}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "0", ",", "Nb"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"z\[Nu]", "[", "\[Nu]_", "]"}], "=", 
    FractionBox[
     RowBox[{
      SqrtBox[
       RowBox[{"4", "-", "\[Nu]0"}]], "-", 
      SqrtBox[
       RowBox[{"4", "-", "\[Nu]"}]]}], 
     RowBox[{
      SqrtBox[
       RowBox[{"4", "-", "\[Nu]0"}]], "+", 
      SqrtBox[
       RowBox[{"4", "-", "\[Nu]"}]]}]]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{"mapping", " ", "to", " ", "unit", " ", "circle"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"ReF", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Re", "[", 
       RowBox[{"F", "[", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"\[ImaginaryI]", " ", 
          RowBox[{"v\[Phi]", "[", 
           RowBox[{"[", "j", "]"}], "]"}]}]], "]"}], "]"}], "//", 
      "ComplexExpand"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", "M"}], "}"}]}], "]"}]}], ";", 
  RowBox[{"ImF", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Im", "[", 
       RowBox[{"F", "[", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"\[ImaginaryI]", " ", 
          RowBox[{"v\[Phi]", "[", 
           RowBox[{"[", "j", "]"}], "]"}]}]], "]"}], "]"}], "//", 
      "ComplexExpand"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", "M"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"btoF0", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Coefficient", "[", 
      RowBox[{
       RowBox[{"F", "[", 
        RowBox[{"z\[Nu]", "[", "0", "]"}], "]"}], ",", 
       SubscriptBox["b", "i"]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "0", ",", "Nb"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"btoReF", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Coefficient", "[", 
      RowBox[{
       RowBox[{"ReF", "[", 
        RowBox[{"[", "j", "]"}], "]"}], ",", 
       SubscriptBox["b", "i"]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", "M"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "0", ",", "Nb"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"btoImF", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Coefficient", "[", 
      RowBox[{
       RowBox[{"ImF", "[", 
        RowBox[{"[", "j", "]"}], "]"}], ",", 
       SubscriptBox["b", "i"]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", "M"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "0", ",", "Nb"}], "}"}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.952512816384555*^9, 3.952512817669591*^9}, 
   3.9676246212795515`*^9, 4.0026179517545986`*^9},
 CellLabel->
  "In[224]:=",ExpressionUUID->"bf30d1cf-9344-4427-98fa-e449a165d0ee"],

