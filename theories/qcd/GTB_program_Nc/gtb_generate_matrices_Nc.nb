Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"SRS0pinch", "[", 
    RowBox[{"Nc_", ",", "mq2_", ",", "\[Alpha]s\[Pi]_", ",", "n_"}], "]"}], ":=", 
   RowBox[{
    FractionBox[
     RowBox[{" ", "mq2", " "}], 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"2", "\[Pi]"}], ")"}], "4"], "8", " ", 
      SuperscriptBox["\[Pi]", "2"]}]], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"2", " ", "Nc", " ", 
       RowBox[{"logpinchint", "[", 
        RowBox[{"1", ",", "2", ",", "n"}], "]"}]}], "+", 
      RowBox[{"\[Alpha]s\[Pi]", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"s1", " ", 
          RowBox[{"logpinchint", "[", 
           RowBox[{"1", ",", "2", ",", "n"}], "]"}]}], "+", 
         RowBox[{"s2", " ", 
          RowBox[{"logpinchint", "[", 
           RowBox[{"2", ",", "2", ",", "n"}], "]"}]}]}], ")"}]}], "+", 
      RowBox[{
       SuperscriptBox["\[Alpha]s\[Pi]", "2"], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"s3", " ", 
          RowBox[{"logpinchint", "[", 
           RowBox[{"1", ",", "2", ",", "n"}], "]"}]}], "+", 
         RowBox[{"s4", " ", 
          RowBox[{"logpinchint", "[", 
           RowBox[{"2", ",", "2", ",", "n"}], "]"}]}], "+", 
         RowBox[{"s5", " ", 
          RowBox[{"logpinchint", "[", 
           RowBox[{"3", ",", "2", ",", "n"}], "]"}]}]}], ")"}]}]}], ")"}]}]}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"SRP1pinch", "[", 
    RowBox[{"Nc_", ",", "\[Alpha]s\[Pi]_", ",", "n_"}], "]"}], ":=", 
   RowBox[{
    FractionBox["Nc", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"2", "\[Pi]"}], ")"}], "4"], "24", " ", 
      SuperscriptBox["\[Pi]", "2"]}]], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"logpinchint", "[", 
       RowBox[{"1", ",", "2", ",", "n"}], "]"}], "+", 
      RowBox[{"r1", " ", "\[Alpha]s\[Pi]", " ", 
       RowBox[{"logpinchint", "[", 
        RowBox[{"1", ",", "2", ",", "n"}], "]"}]}], "+", 
      RowBox[{
       SuperscriptBox["\[Alpha]s\[Pi]", "2"], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"r2", " ", 
          RowBox[{"logpinchint", "[", 
           RowBox[{"1", ",", "2", ",", "n"}], "]"}]}], "+", 
         RowBox[{"r3", " ", 
          RowBox[{"logpinchint", "[", 
           RowBox[{"2", ",", "2", ",", "n"}], "]"}]}]}], ")"}]}]}], ")"}]}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SRD0qpinch", "[", 
    RowBox[{"Nc_", ",", "\[Alpha]s\[Pi]_", ",", "n_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"-", 
     FractionBox["2", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"2", "\[Pi]"}], ")"}], "4"], "16", " ", 
       SuperscriptBox["\[Pi]", "2"]}]]}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"-", " ", 
        FractionBox[
         RowBox[{"2", "Nc"}], "20"]}], 
       RowBox[{"logpinchint", "[", 
        RowBox[{"1", ",", "3", ",", "n"}], "]"}]}], "+", " ", 
      RowBox[{"\[Alpha]s\[Pi]", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"a1", " ", 
          RowBox[{"logpinchint", "[", 
           RowBox[{"1", ",", "3", ",", "n"}], "]"}]}], "+", 
         RowBox[{"a2", " ", 
          RowBox[{"logpinchint", "[", 
           RowBox[{"2", ",", "3", ",", "n"}], "]"}]}]}], ")"}]}]}], ")"}]}]}],
   ";"}]}], "Input",
 CellChangeTimes->{{3.954303454372029*^9, 3.9543035023893156`*^9}, 
