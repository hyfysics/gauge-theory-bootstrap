Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "IMPORTING", " ", "THE", " ", "PYTHON", " ", "COMPUTED", " ", "PHI"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Set", " ", "Parameters"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"Ns", "=", "M"}], ";", 
    RowBox[{"lmax", "=", "lmax"}], ";", 
    RowBox[{"Nl", "=", 
     RowBox[{"lmax", "+", "1"}]}], ";", 
    RowBox[{"Nmax", "=", "nmax"}], ";", 
    RowBox[{"Nmax2", "=", "nmax"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Import", " ", "as", " ", "a", " ", "Table", " ", 
     RowBox[{"(", 
      RowBox[{"Pairs", " ", "of", " ", 
       RowBox[{"Real", "/", "Imag"}]}], ")"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"allData", "=", 
     RowBox[{"SetPrecision", "[", 
      RowBox[{
       RowBox[{"Import", "[", 
        RowBox[{
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"PhiNumPath", "[", "]"}], ",", 
            RowBox[{"\"\<Phiphys_sa_\>\"", "<>", 
             RowBox[{"ToString", "[", 
              RowBox[{"Abs", "[", "\[Nu]0", "]"}], "]"}], "<>", 
             "\"\<_Phisn_PhiHat_sln_PhiTilde_slnm_\>\"", "<>", 
             RowBox[{"ToString", "[", "Ns", "]"}], "<>", "\"\<_\>\"", "<>", 
             RowBox[{"ToString", "[", 
              RowBox[{"Nl", "/", "2"}], "]"}], "<>", "\"\<_\>\"", "<>", 
             RowBox[{"ToString", "[", "nmax", "]"}], "<>", "\"\<_\>\"", "<>", 
             RowBox[{"ToString", "[", "nmax", "]"}], "<>", "\"\<.dat\>\""}]}],
            "}"}], "]"}], ",", "\"\<List\>\""}], "]"}], ",", "p"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Define", " ", "the", " ", "total", " ", "elements", " ", "needed", " ", 
     "for", " ", "each", " ", "array", " ", 
     RowBox[{"(", 
      RowBox[{"Product", " ", "of", " ", "dimensions"}], ")"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sizes", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"2", "*", "Ns", "*", "Nmax"}], ",", 
       RowBox[{"Ns", "*", "Nl", "*", "Nmax"}], ",", 
       RowBox[{"Ns", "*", "Nl", "*", "Nmax", "*", "Nmax"}]}], "}"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"separateLists", "=", 
     RowBox[{"TakeList", "[", 
      RowBox[{"allData", ",", "sizes"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Reshape", " ", "them"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"PhiM", "=", 
     RowBox[{"ArrayReshape", "[", 
      RowBox[{
       RowBox[{"separateLists", "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"Ns", ",", "Nmax", ",", "2"}], "}"}]}], "]"}]}], ";", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"PhiM", "[", "s", "]"}], "[", "n", "]"}], "[", 
       RowBox[{"re", ",", "im"}], "]"}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{"z", "^", "n"}], " ", "vanishes", " ", "at", " ", "s"}], "=", 
       "sa"}]}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{"PhiHat", "=", 
     RowBox[{"ArrayReshape", "[", 
      RowBox[{
       RowBox[{"separateLists", "[", 
        RowBox[{"[", "2", "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"Ns", ",", "Nl", ",", "Nmax"}], "}"}]}], "]"}]}], ";", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{
       RowBox[{"PhiHat", "[", "s", "]"}], "[", "ell", "]"}], "[", "n", "]"}], 
     "*)"}], "\[IndentingNewLine]", 
    RowBox[{"PhiTilde", "=", 
     RowBox[{"ArrayReshape", "[", 
      RowBox[{
       RowBox[{"separateLists", "[", 
        RowBox[{"[", "3", "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"Ns", ",", "Nl", ",", "Nmax", ",", "Nmax"}], "}"}]}], "]"}]}],
     ";", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"PhiTilde", "[", "s", "]"}], "[", "ell", "]"}], "[", "n", 
       "]"}], "[", "m", "]"}], "*)"}], "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"PhiMComplex", "=", 
     RowBox[{
      RowBox[{"PhiM", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "All", ",", "1"}], "]"}], "]"}], "+", 
      RowBox[{"I", "*", 
       RowBox[{"PhiM", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "All", ",", "2"}], "]"}], "]"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"M\[CapitalPhi]phys", "=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"PhiMComplex", "[", 
       RowBox[{"[", 
        RowBox[{
         RowBox[{"1", ";;", "M"}], ",", 
         RowBox[{"1", ";;", "nmax"}]}], "]"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"M\[CapitalPhi]tilde", "=", 
     RowBox[{"Transpose", "[", 
      RowBox[{
       RowBox[{"PhiTilde", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"1", ";;", "M"}], ",", 
          RowBox[{"1", ";;", 
           RowBox[{"lmax", "+", "1"}]}], ",", 
          RowBox[{"1", ";;", "nmax"}], ",", 
          RowBox[{"1", ";;", "nmax"}]}], "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"4", ",", "3", ",", "1", ",", "2"}], "}"}]}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"M\[CapitalPhi]hat", "=", 
     RowBox[{"Transpose", "[", 
      RowBox[{
       RowBox[{"PhiHat", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"1", ";;", "M"}], ",", 
          RowBox[{"1", ";;", 
           RowBox[{"lmax", "+", "1"}]}], ",", 
          RowBox[{"1", ";;", "nmax"}]}], "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"3", ",", "2", ",", "1"}], "}"}]}], "]"}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9825127114060235`*^9, 3.9825127114176016`*^9}, {
