Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ssym", "=", 
    FractionBox["4", "3"]}], ";", 
   RowBox[{"tsym", "=", 
    FractionBox["4", "3"]}], ";", 
   RowBox[{"usym", "=", 
    FractionBox["4", "3"]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
   "evaluate", " ", "at", " ", "some", " ", "kinematic", " ", "point"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"zS", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Sqrt", "[", 
       RowBox[{"4", "-", "\[Nu]0"}], "]"}], "-", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"4", "-", "ssym"}], "]"}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Sqrt", "[", 
       RowBox[{"4", "-", "\[Nu]0"}], "]"}], "+", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"4", "-", "ssym"}], "]"}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"zT", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Sqrt", "[", 
       RowBox[{"4", "-", "\[Nu]0"}], "]"}], "-", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"4", "-", "tsym"}], "]"}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Sqrt", "[", 
       RowBox[{"4", "-", "\[Nu]0"}], "]"}], "+", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"4", "-", "tsym"}], "]"}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"zU", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Sqrt", "[", 
       RowBox[{"4", "-", "\[Nu]0"}], "]"}], "-", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"4", "-", "usym"}], "]"}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Sqrt", "[", 
       RowBox[{"4", "-", "\[Nu]0"}], "]"}], "+", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"4", "-", "usym"}], "]"}]}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nList", "=", 
   RowBox[{"Range", "[", "nmax", "]"}]}], ";", 
  RowBox[{"(*", 
   RowBox[{"range", " ", "of", " ", "n"}], "*)"}], "\n", 
  RowBox[{"phiS", "=", 
   RowBox[{"zS", "^", "nList"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"phiT", "=", 
   RowBox[{"zT", "^", "nList"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"phiU", "=", 
   RowBox[{"zU", "^", "nList"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"va0", "=", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"va1n", "=", "phiS"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"va2n", "=", 
   RowBox[{"phiT", "+", "phiU"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"va1nm", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{"Outer", "[", 
     RowBox[{"Times", ",", "phiS", ",", 
      RowBox[{"phiT", "+", "phiU"}]}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"coeffi", "=", 
   RowBox[{"Outer", "[", 
    RowBox[{"Times", ",", "phiT", ",", "phiU"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"va2nmsym", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", "diagMask"}], ")"}], "*", 
      RowBox[{"Extract", "[", 
       RowBox[{"coeffi", ",", "indicesupper"}], "]"}]}], "+", 
     RowBox[{"Extract", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", "coeffi", "]"}], ",", "indicesupper"}], 
      "]"}]}]}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"5.", " ", "Assemble"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Ac", "=", 
   RowBox[{"SetPrecision", "[", 
    RowBox[{
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"{", "va0", "}"}], ",", "va1n", ",", "va2n", ",", "va1nm", ",",
        "va2nmsym"}], "]"}], ",", "p"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.982736149726075*^9, 3.982736162980193*^9}, {
