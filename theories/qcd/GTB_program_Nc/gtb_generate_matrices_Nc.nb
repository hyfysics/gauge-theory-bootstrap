        RowBox[{"z", "^", "n"}], " ", "vanishes", " ", "at", " ", "s"}], "=", 
       "sa"}]}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{"PhiHatC", "=", 
     RowBox[{"ArrayReshape", "[", 
