       RowBox[{"PhiHat", "[", "s", "]"}], "[", "ell", "]"}], "[", "n", "]"}], 
     "*)"}], "\[IndentingNewLine]", 
    RowBox[{"PhiTildeC", "=", 
     RowBox[{"ArrayReshape", "[", 
      RowBox[{
