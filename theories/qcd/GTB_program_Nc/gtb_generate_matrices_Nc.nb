Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalLambda]", "[", 
    RowBox[{"s_", ",", "l_"}], "]"}], "=", 
   SqrtBox[
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox[
       RowBox[{
        SqrtBox["s"], "-", "2"}], 
       RowBox[{
        SqrtBox["s"], "+", "2"}]], ")"}], "l"]]}], ";", 
  RowBox[{"(*", 
   RowBox[{"l", " ", "dependent", " ", "rescaling", " ", "factor"}], 
   "*)"}]}]], "Input",
