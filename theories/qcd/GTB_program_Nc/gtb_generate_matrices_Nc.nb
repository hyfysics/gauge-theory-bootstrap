Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ints0", "[", 
    RowBox[{"n_", ",", "nl_", ",", "s0_", ",", "fn_"}], "]"}], ":=", 
   RowBox[{
    FractionBox["1", 
     SuperscriptBox["s0", 
      RowBox[{"n", "+", "nl"}]]], 
    RowBox[{"NIntegrate", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"dx\[Phi]", "[", "\[Phi]", "]"}], 
       SuperscriptBox[
        RowBox[{"\[Nu]\[Phi]", "[", "\[Phi]", "]"}], "n"], 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         FractionBox[
          RowBox[{"\[Nu]\[Phi]", "[", "\[Phi]", "]"}], "s0"]}], ")"}], 
       SuperscriptBox["\[ExponentialE]", 
        FractionBox[
         RowBox[{"-", 
          RowBox[{"\[Nu]\[Phi]", "[", "\[Phi]", "]"}]}], "s0"]], "fn"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Phi]", ",", "0", ",", 
        RowBox[{"\[Phi]\[Nu]", "[", "s0", "]"}]}], "}"}]}], "]"}]}]}], 
  ";"}]], "Input",
