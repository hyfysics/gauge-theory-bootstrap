Cell[BoxData[
 RowBox[{
  RowBox[{"logpinchint", "[", 
   RowBox[{"nlog_", ",", "nl_", ",", "n_"}], "]"}], ":=", 
  RowBox[{"Re", "[", 
   RowBox[{"NIntegrate", "[", 
    RowBox[{
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"\[ImaginaryI]", " ", 
        RowBox[{"(", 
         RowBox[{"n", "+", "nl"}], ")"}], " ", "\[Phi]"}]], 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"\[ImaginaryI]", " ", "\[Phi]"}]]}], ")"}], 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"-", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"\[ImaginaryI]", " ", "\[Phi]"}]]}]], 
      SuperscriptBox[
       RowBox[{"Log", "[", 
        RowBox[{"-", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{"\[ImaginaryI]", " ", "\[Phi]"}]]}], "]"}], "nlog"]}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Phi]", ",", "0", ",", 
       RowBox[{"2", "\[Pi]"}]}], "}"}]}], "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.954904005118739*^9, 3.954904099959474*^9}, {
   3.9850730183487263`*^9, 3.98507303618476*^9}, {3.9850742713166213`*^9, 
   3.9850743025855227`*^9}, {3.985074346967916*^9, 3.985074348900503*^9}, 
   4.0026177436670346`*^9, 4.0026183859871283`*^9},
 CellLabel->"In[34]:=",ExpressionUUID->"e9103376-8d15-4c1b-86f8-d324670f26cc"],

