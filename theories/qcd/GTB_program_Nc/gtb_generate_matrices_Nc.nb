Cell[TextData[{
 "spectral density rescaling factor between \[Rho] and ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[Rho]", "^"], TraditionalForm]],ExpressionUUID->
  "7bda3dd6-570c-4a1b-a717-dbf8f7acaf60"],
 " for S0, P1, D0, always in pion mass unit"
}], "Text",
 CellChangeTimes->{{4.000292453824742*^9, 
  4.000292492629633*^9}},ExpressionUUID->"c309d842-7fb0-4fa8-8c31-\
eed4c41ccc34"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Rho]hatUVS0s", "=", 
   FractionBox[
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "2"}], "\[Pi]"}], ")"}]}], 
      FractionBox["s", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"2", "\[Pi]"}], ")"}], "4"]], 
      FractionBox[
       RowBox[{"nf", " ", "mq2"}], 
       RowBox[{"16", 
        SuperscriptBox["\[Pi]", "2"]}]], " ", "2", "Nc"}], "/.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"mq2", "\[Rule]", "mq22GeV"}], ",", 
       RowBox[{"nf", "\[Rule]", "2"}]}], "}"}]}], 
    FractionBox[
     RowBox[{"\[Rho]S0fac", "[", "s", "]"}], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", "-", 
        FractionBox["4", "s"]}], ")"}], 
      FractionBox["1", "2"]]]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Rho]hatUVP1", "=", 
   FractionBox[
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "2"}], "\[Pi]"}], ")"}]}], 
       FractionBox["s", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"2", "\[Pi]"}], ")"}], "4"]], " ", 
       FractionBox[
        RowBox[{"nf", " ", "Nc"}], 
        RowBox[{"48", 
         SuperscriptBox["\[Pi]", "2"]}]]}], "/.", 
      RowBox[{"{", 
       RowBox[{"nf", "\[Rule]", "2"}], "}"}]}], "//", "N"}], 
    FractionBox[
     RowBox[{"\[Rho]P1fac", "[", "s", "]"}], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", "-", 
        FractionBox["4", "s"]}], ")"}], 
      FractionBox["3", "2"]]]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Rho]hatUVD0q", "=", 
   FractionBox[
    RowBox[{
     RowBox[{
      RowBox[{"2", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "2"}], "\[Pi]"}], ")"}], 
       FractionBox[
        SuperscriptBox["s", "2"], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"2", "\[Pi]"}], ")"}], "4"]], 
       FractionBox["1", 
        RowBox[{"16", 
         SuperscriptBox["\[Pi]", "2"]}]], " ", 
       FractionBox[
        RowBox[{
         RowBox[{"-", "nf"}], " ", "Nc"}], "20"]}], "/.", 
      RowBox[{"{", 
       RowBox[{"nf", "\[Rule]", "2"}], "}"}]}], "//", "N"}], 
    FractionBox[
     RowBox[{"\[Rho]D0fac", "[", "s", "]"}], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", "-", 
        FractionBox["4", "s"]}], ")"}], 
      FractionBox["5", "2"]]]]}], ";"}]}], "Input",
