         SuperscriptBox[
          RowBox[{"(", 
           FractionBox["2000", "140"], ")"}], "2"], "]"}]], ")"}], 
      RowBox[{"-", 
       FractionBox[
        RowBox[{"3", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", 
           SuperscriptBox["Nc", "2"]}], ")"}]}], 
        RowBox[{"2", " ", "Nc", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", 
            FractionBox[
             RowBox[{"11", " ", "Nc"}], "3"]}], "+", 
           FractionBox[
            RowBox[{"2", " ", "Nf"}], "3"]}], ")"}]}]]}]], "mq22GeV"}], "/.", 
    RowBox[{"Nf", "\[Rule]", "2"}]}]}], ";", 
  RowBox[{
   RowBox[{"mq2s0", "[", "Nc_", "]"}], "=", 
