   "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Set", " ", "Parameters"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"Nsu", "=", "Munphys"}], ";", 
    RowBox[{"lmaxu", "=", "lmaxun"}], ";", 
    RowBox[{"Nlu", "=", 
     RowBox[{"lmaxu", "+", "1"}]}], ";", 
    RowBox[{"Nmax", "=", "nmax"}], ";", 
    RowBox[{"Nmax2", "=", "nmax"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Import", " ", "as", " ", "a", " ", "Table", " ", 
     RowBox[{"(", 
      RowBox[{"Pairs", " ", "of", " ", 
       RowBox[{"Real", "/", "Imag"}]}], ")"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"allData", "=", 
     RowBox[{"SetPrecision", "[", 
      RowBox[{
       RowBox[{"Import", "[", 
        RowBox[{
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"PhiNumPath", "[", "]"}], ",", 
            RowBox[{"\"\<Phiunphys_sa_\>\"", "<>", 
             RowBox[{"ToString", "[", 
              RowBox[{"Abs", "[", "\[Nu]0", "]"}], "]"}], "<>", 
             "\"\<_Phisn_PhiHat_sln_PhiTilde_slnm_\>\"", "<>", 
             RowBox[{"ToString", "[", "Nsu", "]"}], "<>", "\"\<_\>\"", "<>", 
             RowBox[{"ToString", "[", 
              RowBox[{"Nlu", "/", "2"}], "]"}], "<>", "\"\<_\>\"", "<>", 
             RowBox[{"ToString", "[", "nmax", "]"}], "<>", "\"\<_\>\"", "<>", 
             RowBox[{"ToString", "[", "nmax", "]"}], "<>", "\"\<.dat\>\""}]}],
            "}"}], "]"}], ",", "\"\<List\>\""}], "]"}], ",", "p"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Define", " ", "the", " ", "total", " ", "elements", " ", "needed", " ", 
     "for", " ", "each", " ", "array", " ", 
     RowBox[{"(", 
      RowBox[{"Product", " ", "of", " ", "dimensions"}], ")"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sizes", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Nsu", "*", "Nmax"}], ",", 
       RowBox[{"Nsu", "*", "Nlu", "*", "Nmax"}], ",", 
       RowBox[{"Nsu", "*", "Nlu", "*", "Nmax", "*", "Nmax"}]}], "}"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"separateLists", "=", 
     RowBox[{"TakeList", "[", 
      RowBox[{"allData", ",", "sizes"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Reshape", " ", "them"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"PhiMC", "=", 
     RowBox[{"ArrayReshape", "[", 
      RowBox[{
       RowBox[{"separateLists", "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"Nsu", ",", "Nmax"}], "}"}]}], "]"}]}], ";", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{
       RowBox[{
