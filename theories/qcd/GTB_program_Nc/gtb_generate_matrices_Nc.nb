   RowBox[{"md2GeV", "=", 
    FractionBox["6.5", "unit"]}], ";", 
   RowBox[{"mq22GeV", "=", 
    FractionBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["mu2GeV", "2"], "+", 
       SuperscriptBox["md2GeV", "2"]}], ")"}], "2"]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"quark", " ", "mass", " ", "at", " ", "2", " ", "GeV"}], 
   "*)"}]}], "\[IndentingNewLine]", 
